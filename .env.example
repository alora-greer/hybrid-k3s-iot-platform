# Copy to `.env` (gitignored) and fill in. Used by `make render` to substitute
# environment-specific values into k8s-manifests/ without committing them.
#
#   cp .env.example .env

# --- Home Assistant (Raspberry Pi) -------------------------------------------
# Host:port Prometheus should scrape, e.g. the Pi's DHCP-reserved address.
HA_SCRAPE_TARGET=homeassistant.lan:8123

# --- Public hostnames served through the Cloudflare Tunnel -------------------
GRAFANA_HOST=grafana.example.com

# --- Cloudflare Tunnel -------------------------------------------------------
# Pin a specific release: https://github.com/cloudflare/cloudflared/releases
CLOUDFLARED_IMAGE_TAG=<pin-a-release>

# --- K8sGPT -> Ollama on the Mac workstation ---------------------------------
# Ollama must listen on the LAN (OLLAMA_HOST=0.0.0.0) for in-cluster access.
OLLAMA_BASE_URL=http://workstation.lan:11434/v1
OLLAMA_MODEL=llama3.1:8b
# Pin a specific release: https://github.com/k8sgpt-ai/k8sgpt/releases
K8SGPT_VERSION=<pin-a-release>

# --- Secrets (only used locally by `make seal-*`; never rendered to disk) ----
HA_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=
